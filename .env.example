# Copy to .env with `make env` (generates random secrets for every CHANGE_ME).
# .env is git-ignored. Never commit real credentials.

# --- PostgreSQL + PostGIS + pgvector ------------------------------------------
POSTGRES_USER=pids
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=pids
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (realtime fan-out, rate limits) ------------------------------------
REDIS_PASSWORD=CHANGE_ME
REDIS_HOST=localhost
REDIS_PORT=6379

# --- MQTT (edge -> cloud telemetry) -------------------------------------------
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_SERVER_USER=pids-server
MQTT_SERVER_PASSWORD=CHANGE_ME
# The edge node authenticates with its node id as the username (see infra/mosquitto/acl).
MQTT_EDGE_USER=edge-01
MQTT_EDGE_PASSWORD=CHANGE_ME
# Set to infra/certs/out/ca.crt to connect over TLS (8883) with the broker verified
# (make certs). Required for edge nodes on another machine.
MQTT_CA_FILE=

# --- API auth -----------------------------------------------------------------
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# --- Demo accounts (created by `make seed`; see pids-admin) -------------------
# admin@pids.local, operator@pids.local, guard.alpha@pids.local, guard.bravo@pids.local
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_OPERATOR_PASSWORD=CHANGE_ME
SEED_GUARD_PASSWORD=CHANGE_ME

# --- MQTT simulator identity (dev only: may publish as any edge node) ----------
MQTT_SIM_USER=pids-sim
MQTT_SIM_PASSWORD=CHANGE_ME

# --- Site ---------------------------------------------------------------------
PIDS_SITE_CONFIG=config/sites/site-alpha.yaml

# --- LLM agent layer (AIL-06/07/08) -------------------------------------------
# Paste your own key here; it is read only by the server process.
ANTHROPIC_API_KEY=
# anthropic | ollama
LLM_PROVIDER=anthropic
# Claude Opus 5.5 by default; effort low|medium|high|xhigh|max
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=high
# Offline fallback (ADR-0007): a local Ollama. From the containers the host is
# host.docker.internal; leave empty if Ollama is not installed.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3:4b

# --- Push notifications (guard app) -------------------------------------------
EXPO_ACCESS_TOKEN=

# Site key for passive BLE badges (ADR-0012): every badge's secret derives from it.
PIDS_BADGE_KEY=CHANGE_ME

# Grafana admin (make obs)
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
