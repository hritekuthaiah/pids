{
  "uid": "pids-ops",
  "title": "PIDS \u2014 operations",
  "tags": [
    "pids"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Capture \u2192 decision p95",
      "description": "NFR-01 budget: an alert is visible < 2 s after the breach",
      "datasource": {
        "type": "prometheus",
        "uid": "pids-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pids_pipeline_latency_seconds_bucket{hop=\"captured->decided\"}[1m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "pids-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Entities assessed",
      "description": "",
      "datasource": {
        "type": "prometheus",
