    {
      "type": "timeseries",
      "title": "Pipeline latency by hop (p50 / p95)",
      "description": "Measured from per-message traces stamped at every hop (edge \u2192 broker \u2192 decision)",
      "datasource": {
        "type": "prometheus",
        "uid": "pids-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, hop) (rate(pids_pipeline_latency_seconds_bucket[1m])))",
          "legendFormat": "p50 {{hop}}",
          "datasource": {
            "type": "prometheus",
            "uid": "pids-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, hop) (rate(pids_pipeline_latency_seconds_bucket[1m])))",
          "legendFormat": "p95 {{hop}}",
          "datasource": {
            "type": "prometheus",
            "uid": "pids-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 5
    },
