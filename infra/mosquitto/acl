# Topic layout:  pids/<site_id>/<node_id>/<stream>
#   streams published by edge nodes: tracks, gps, sensors, health, view
#   commands published by the server:  pids/<site_id>/<node_id>/cmd/<name>

# The decision service reads all telemetry and may command any node.
user pids-server
topic read pids/#
topic read $SYS/#
topic write pids/+/+/cmd/#
# guard-phone GPS fixes arrive over HTTPS and are republished as node "api"
topic write pids/+/api/gps

# Development-only simulator: plays every edge node of a site. Never provision
# this user in a real deployment.
user pids-sim
topic write pids/+/+/tracks
topic write pids/+/+/gps
topic write pids/+/+/sensors
topic write pids/+/+/health
topic write pids/+/+/view

# Edge nodes authenticate with their node id as username (%u) and may only
# publish their own telemetry and read their own commands.
pattern write pids/+/%u/tracks
pattern write pids/+/%u/gps
pattern write pids/+/%u/sensors
pattern write pids/+/%u/health
pattern write pids/+/%u/view
pattern read pids/+/%u/cmd/#
